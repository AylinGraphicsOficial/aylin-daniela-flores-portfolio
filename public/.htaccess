DirectoryIndex production.html index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Fallback to public/ directory if requested asset was cloned by Git
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
  RewriteRule ^(.*)$ /public/$1 [L]

  # 2. Route root and index.html to production.html if it exists
  RewriteCond %{DOCUMENT_ROOT}/production.html -f
  RewriteRule ^$ /production.html [L]

  RewriteCond %{DOCUMENT_ROOT}/production.html -f
  RewriteRule ^index\.html$ /production.html [L]

  # 3. If file or directory exists physically, serve directly with no rewrite
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Never rewrite static assets to HTML; let server return clean 404 if missing
  RewriteCond %{REQUEST_URI} \.(css|js|mjs|webp|png|jpg|jpeg|gif|svg|ico|glb|gltf|mp4|webm|pdf|woff|woff2|ttf|eot)$ [NC]
  RewriteRule ^ - [L]

  # 5. SPA Fallback: rewrite client-side routes to production.html (or index.html)
  RewriteCond %{DOCUMENT_ROOT}/production.html -f
  RewriteRule . /production.html [L]

  RewriteRule . /index.html [L]
</IfModule>

# GZIP / Brotli-style compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml application/xml font/woff font/woff2
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed build assets (Vite) - safe to cache for 1 year
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  # Images & fonts
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
  # HTML always fresh
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Long-lived immutable cache for Vite hashed assets
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|ico)$">
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
